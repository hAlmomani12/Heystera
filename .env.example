# Voice provider: gemini or openai (if empty: Gemini when GEMINI_API_KEY exists)
VOICE_PROVIDER=gemini
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.8-live
GEMINI_VOICE=Puck
# OpenAI (optional, used when VOICE_PROVIDER=openai)
OPENAI_API_KEY=sk-...
REALTIME_MODEL=gpt-realtime-2.1
VOICE=marin
# Protection for public deployments
ACCESS_CODE=
MAX_SESSIONS_PER_DAY=150
MAX_CALL_MINUTES=8
PORT=8000
